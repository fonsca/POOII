# Copie para ".env" nesta pasta. O .env não vai para o Git.
ASPNETCORE_ENVIRONMENT=Development

# Banco SQLite (caminho relativo à pasta API)
ConnectionStrings__Default="Data Source=../SQLite.db"

# Endereço da API
Api__Url=http://localhost:5000

# Origens do front liberadas no CORS (separadas por vírgula)
Cors__AllowedOrigins=http://localhost:5173,http://127.0.0.1:5173

# Mentor criado automaticamente se o banco não tiver nenhum mentor
Seed__MentorName="Mentor Demo"
Seed__MentorEmail=admin@primeirachamada.com
Seed__MentorPassword=senha@123